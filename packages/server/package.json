{
	"name": "@rest-rpc/server",
	"version": "0.8.0",
	"description": "Type-safe HTTP routes that are server handlers, typed clients, and MCP server and agent SDK tools, for Fetch and Node runtimes.",
	"keywords": [
		"agent-tools",
		"bun",
		"cloudflare-workers",
		"contract-first",
		"deno",
		"end-to-end-type-safety",
		"fetch",
		"http",
		"mcp",
		"middleware",
		"model-context-protocol",
		"node",
		"rest",
		"rest-rpc",
		"route-handlers",
		"server",
		"server-sent-events",
		"standard-schema",
		"type-safe-api",
		"typescript",
		"validation"
	],
	"homepage": "https://rest-rpc.vercel.app/docs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/rest-rpc.git",
		"directory": "packages/server"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./node": "./src/node/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./node": {
				"types": "./dist/node/index.d.ts",
				"import": "./dist/node/index.js",
				"default": "./dist/node/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit --declaration false"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*"
	}
}
