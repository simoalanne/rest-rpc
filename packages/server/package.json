{
	"name": "@rest-rpc/server",
	"version": "0.1.0-beta.24",
	"description": "Type-safe rest-rpc route handlers for Fetch and Node HTTP runtimes.",
	"keywords": [
		"api-contract",
		"contract-first",
		"fetch",
		"http",
		"middleware",
		"node",
		"rest",
		"rest-rpc",
		"route-handlers",
		"rpc",
		"server",
		"type-safe-api",
		"typescript"
	],
	"homepage": "https://github.com/simoalanne/rest-rpc#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/rest-rpc.git",
		"directory": "packages/server"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./node": "./src/node/adapter.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./node": {
				"types": "./dist/node/adapter.d.ts",
				"import": "./dist/node/adapter.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit --declaration false"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*",
		"rou3": "^1.0.0"
	}
}
