{
	"name": "@rest-rpc/tanstack-query",
	"version": "0.8.2",
	"description": "TanStack Query options and query keys for rest-rpc clients.",
	"keywords": [
		"contract-first",
		"data-fetching",
		"end-to-end-type-safety",
		"query-client",
		"query-keys",
		"query-options",
		"react-query",
		"rest",
		"rest-rpc",
		"tanstack-query",
		"type-safe-api",
		"typescript"
	],
	"homepage": "https://rest-rpc.vercel.app/docs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/rest-rpc.git",
		"directory": "packages/tanstack-query"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit --declaration false"
	},
	"dependencies": {
		"@rest-rpc/core": "workspace:*"
	},
	"peerDependencies": {
		"@tanstack/query-core": ">=5.86.0 <6.0.0"
	}
}
