{
	"name": "rest-rpc",
	"private": true,
	"homepage": "https://github.com/simoalanne/rest-rpc#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoalanne/rest-rpc.git"
	},
	"type": "module",
	"scripts": {
		"build:packages": "pnpm -r --filter './packages/**' build",
		"bench:typecheck": "pnpm --filter benchmarks bench:typecheck",
		"test": "vitest run --typecheck",
		"typecheck": "pnpm -r --parallel --no-bail --filter './packages/**' typecheck",
		"lint": "oxlint",
		"lint:staged": "lint-staged",
		"lint:unsafe": "oxlint --fix-dangerously",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"changeset:version": "changeset version && pnpm install --lockfile-only --no-frozen-lockfile",
		"release": "pnpm run build:packages && changeset publish",
		"release:github:notes": "node scripts/create-github-release.ts",
		"api:docs:verify": "node scripts/check-public-api-docs.ts",
		"readme:sync": "node scripts/sync-readme.ts",
		"readme:verify": "node scripts/sync-readme.ts --check",
		"check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run api:docs:verify && pnpm run readme:verify",
		"docs:dev": "pnpm --filter content dev",
		"docs:build": "pnpm --filter content build",
		"docs:preview": "pnpm --filter content preview"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@types/node": "26.6.5",
		"lefthook": "2.2.2",
		"lint-staged": "17.6.0",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"typescript": "^7.0.2",
		"typescript-compiler-api": "npm:typescript@5.9.3",
		"vitest": "5.0.5"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix --no-error-on-unmatched-pattern"
	},
	"packageManager": "pnpm@12.14.0"
}
